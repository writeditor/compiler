<?xml version="1.0"?>
<!-- Starting point for a new venue: RASH head -> \documentclass{@CLASS@}, \title, \author (names joined by \and), abstract, keywords. Body and abstract come from toLaTeX as parameters.
     Written to fit the plain article form; when the class has its own front-matter commands (see its sample), edit the <xsl:text> parts below. Compare with ceur/export.xsl for \author[n]{..} and \address[n]{..}. -->
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="text"/>
<xsl:param name="abstract"/>
<xsl:param name="body"/>

<xsl:template match="/html">
  <xsl:variable name="meta" select="head/meta"/>
  <xsl:text>\documentclass{@CLASS@}
\usepackage[utf8]{inputenc}
\title{</xsl:text><xsl:value-of select="normalize-space(head/title)"/><xsl:text>}
\author{</xsl:text>
  <xsl:for-each select="$meta[@name = 'dc.creator']"><xsl:if test="position() &gt; 1"><xsl:text> \and </xsl:text></xsl:if><xsl:value-of select="@content"/></xsl:for-each>
  <xsl:text>}
\begin{document}
\maketitle
\begin{abstract}
</xsl:text><xsl:value-of select="$abstract"/><xsl:text>
\end{abstract}
</xsl:text>
  <xsl:if test="$meta[@property = 'prism:keyword']">
    <xsl:text>\textbf{Keywords:} </xsl:text>
    <xsl:for-each select="$meta[@property = 'prism:keyword']"><xsl:if test="position() &gt; 1">, </xsl:if><xsl:value-of select="@content"/></xsl:for-each>
    <xsl:text>

</xsl:text>
  </xsl:if>
  <xsl:value-of select="$body"/><xsl:text>\end{document}
</xsl:text>
</xsl:template>
</xsl:stylesheet>
